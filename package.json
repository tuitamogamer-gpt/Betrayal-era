{
  "name": "betrayal-of-the-second-era",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js && playwright test",
    "test:rules": "node --test tests/rules.test.js",
    "start": "node serve.mjs",
    "play": "npm run build && node serve.mjs",
    "test:server": "node --test tests/server.test.js",
    "test:tabletop": "node --test tests/tabletop-*.test.js",
    "dev:tabletop-api": "node server/tabletop/dev-server.js --memory"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.1.12"
  }
}
